DATABASE_URL="mysql://root:@localhost:3306/campus_coin"
JWT_SECRET=change_this_to_a_random_secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: real delivery for password-reset emails. Leave all of these unset
# for local dev — falls back to a disposable Ethereal test inbox (a preview
# link is printed to the console instead of being delivered). Checked in this
# order: EmailJS, then SMTP, then the Ethereal fallback.

# Option A — EmailJS (https://www.emailjs.com). Create an Email Service +
# Template there (template should reference {{to_email}}, {{subject}},
# {{reset_url}}), then enable a Private Key under Account > API Keys so
# server-side (non-browser) requests are accepted.
# EMAILJS_SERVICE_ID=service_xxxxxxx
# EMAILJS_TEMPLATE_ID=template_xxxxxxx
# EMAILJS_PUBLIC_KEY=your_public_key
# EMAILJS_PRIVATE_KEY=your_private_key

# Option B — plain SMTP (e.g. Gmail with an App Password).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Campus Coin <you@gmail.com>"
