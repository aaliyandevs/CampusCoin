DATABASE_URL="mysql://root:@localhost:3306/campus_coin"
JWT_SECRET=change_this_to_a_random_secret
PORT=5000
CLIENT_URL=http://localhost:5173

# Optional: real SMTP delivery for password-reset emails.
# Leave unset for local dev — falls back to a disposable Ethereal test inbox
# (a preview link is printed to the console instead of being delivered).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="Campus Coin <you@gmail.com>"
